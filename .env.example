# Copiez ce fichier en .env et ajustez. Ne committez jamais le .env réel
# (déjà exclu par .gitignore).

ENVIRONMENT=development

# --- Modèle ---
BASE_MODEL_ID=runwayml/stable-diffusion-v1-5
DEVICE=auto

# --- Base de données (historique des jobs) ---
# SQLite par défaut, suffisant pour un seul conteneur API en mode "inline".
# En cas de worker séparé (docker compose --profile async), passez sur Postgres :
#   DATABASE_URL=postgresql+psycopg2://simpsons:simpsons@postgres:5432/simpsons
DATABASE_URL=sqlite:///./app.db

# --- File d'attente ---
# "inline" : la génération tourne dans le process API, aucune dépendance externe.
# "rq"     : dépose les jobs dans Redis, consommés par `python -m app.worker`.
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Stockage des images ---
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
# STORAGE_BACKEND=s3 :
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=            # laisser vide pour AWS S3, sinon endpoint R2/MinIO
# S3_PUBLIC_BASE_URL=         # URL publique/CDN devant le bucket
# S3_PREFIX=

# --- Sécurité ---
# Origines autorisées à appeler l'API (liste séparée par des virgules).
CORS_ALLOW_ORIGINS=http://localhost:3000
# Clés API acceptées côté client, séparées par des virgules. Vide = pas d'auth
# (accepté en dev, refusé au démarrage si ENVIRONMENT=production).
API_KEYS=
RATE_LIMIT=20/minute

# --- Modération de contenu ---
ENABLE_NSFW_FILTER=true
NSFW_MODEL_ID=Falconsai/nsfw_image_detection
NSFW_THRESHOLD=0.85
MODERATION_BLOCKLIST=child,minor,underage,loli

# --- Observabilité ---
SENTRY_DSN=

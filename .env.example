# Copiez ce fichier en .env et ajustez. Ne committez jamais le .env réel
# (déjà exclu par .gitignore).

ENVIRONMENT=development

# --- Modèle ---
# SD1.5 de base (comme simpsonGenerator_FIXED.ipynb) + VAE affiné (vide = VAE de SD1.5).
BASE_MODEL_ID=stable-diffusion-v1-5/stable-diffusion-v1-5
VAE_MODEL_ID=stabilityai/sd-vae-ft-mse
LCM_LORA_ID=latent-consistency/lcm-lora-sdv1-5
CONTROLNET_MODEL_ID=lllyasviel/control_v11p_sd15_canny
IMAGE_RESOLUTION=512
# LoRA Simpsons SD1.5, lu dans simpsons_lora_results/ (monté en lecture seule dans Docker).
LORA_FILE=sd15_lora.safetensors
LORA_SCALE=0.8
# Hires fix (mode texte, hors turbo) : upscale x1.5 + 2e passe img2img.
HIRES_FIX=true
HIRES_SCALE=1.5
HIRES_STRENGTH=0.4
DEVICE=auto

# --- Base de données (historique des jobs) ---
# SQLite par défaut, suffisant pour un seul conteneur API en mode "inline".
# En cas de worker séparé (docker compose --profile async), passez sur Postgres :
#   DATABASE_URL=postgresql+psycopg2://simpsons:simpsons@postgres:5432/simpsons
# Docker : DATABASE_URL=sqlite:////srv/data/app.db (volume db_data, persisté)
DATABASE_URL=sqlite:///./app.db

# --- File d'attente ---
# "inline" : la génération tourne dans le process API, aucune dépendance externe.
# "rq"     : dépose les jobs dans Redis, consommés par `python -m app.worker`.
QUEUE_BACKEND=inline
REDIS_URL=redis://localhost:6379/0

# --- Stockage des images ---
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
# STORAGE_BACKEND=s3 :
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=            # laisser vide pour AWS S3, sinon endpoint R2/MinIO
# S3_PUBLIC_BASE_URL=         # obligatoire : URL publique/CDN devant le bucket
# S3_PREFIX=

# --- Sécurité ---
# Origines autorisées à appeler l'API (liste séparée par des virgules).
CORS_ALLOW_ORIGINS=http://localhost:3000
# Clés API acceptées côté client, séparées par des virgules. Vide = pas d'auth
# (accepté en dev, refusé au démarrage si ENVIRONMENT=production).
API_KEYS=
RATE_LIMIT=20/minute

# --- Modération de contenu ---
ENABLE_NSFW_FILTER=true
NSFW_MODEL_ID=Falconsai/nsfw_image_detection
NSFW_THRESHOLD=0.85
MODERATION_BLOCKLIST=child,children,minor,underage,loli

# --- Observabilité ---
SENTRY_DSN=
